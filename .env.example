# ---- Supabase (Project settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # server only, never expose

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000  # your production URL on Vercel
ADMIN_EMAILS=shweta@example.com             # comma-separated bootstrap admins (more can be added in the panel)

# ---- Email alerts for new orders and enquiries (Resend, optional) ----
RESEND_API_KEY=
EMAIL_FROM=Ruhh <orders@yourdomain.com>     # must be a verified sender in Resend
ORDER_ALERT_EMAIL=shweta@example.com        # comma-separated

# ---- Keep-alive cron (optional; Vercel sends this header automatically when set) ----
CRON_SECRET=choose-a-long-random-string

# ---- WhatsApp Business (Cloud API) — optional, app works without it ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_ORDER_TEMPLATE=                    # approved template: {{1}}=first name {{2}}=order ref {{3}}=total
WHATSAPP_STATUS_TEMPLATE=                   # approved template: {{1}}=first name {{2}}=order ref {{3}}=status
WHATSAPP_OWNER_ALERT_NUMBER=                # Shweta's personal number for new-order alerts (digits)
